<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="16dp"
    tools:context=".MainActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <!-- App Title / Hero Section -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.ScreenMonitor.HeadlineSmall"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="@string/desc_screen_capture"
                android:textAppearance="@style/TextAppearance.ScreenMonitor.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Status Section Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ScreenMonitor.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_status"
                        android:textAppearance="@style/TextAppearance.ScreenMonitor.TitleMedium"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/status_checking"
                        android:textAppearance="@style/TextAppearance.ScreenMonitor.BodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvLastSync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/status_stopped"
                        android:textAppearance="@style/TextAppearance.ScreenMonitor.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Apps Script Section Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ScreenMonitor.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_apps_script"
                        android:textAppearance="@style/TextAppearance.ScreenMonitor.TitleMedium"
                        android:textColor="?attr/colorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetWebAppUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/btn_set_web_app_url"
                        app:icon="@drawable/ic_link"
                        app:iconGravity="start"
                        app:iconPadding="8dp"
                        style="@style/Widget.ScreenMonitor.Button.Filled" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestConnection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/btn_test_connection"
                        app:icon="@drawable/ic_cloud_sync"
                        app:iconGravity="start"
                        app:iconPadding="8dp"
                        style="@style/Widget.ScreenMonitor.Button.Outlined" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_copy_error"
                        app:icon="@drawable/ic_content_copy"
                        app:iconGravity="start"
                        app:iconPadding="8dp"
                        android:visibility="gone"
                        style="@style/Widget.Material3.Button.TextButton" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Account Type Selection Section Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ScreenMonitor.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_account_type"
                        android:textAppearance="@style/TextAppearance.ScreenMonitor.TitleMedium"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/section_account_type_desc"
                        android:textAppearance="@style/TextAppearance.ScreenMonitor.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <RadioGroup
                        android:id="@+id/rgAccountType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:checkedButton="@+id/rbReal">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbReal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/rb_real"
                            android:textAppearance="@style/TextAppearance.ScreenMonitor.BodyLarge"
                            android:padding="12dp"
                            android:buttonTint="?attr/colorPrimary" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbDemo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/rb_demo"
                            android:textAppearance="@style/TextAppearance.ScreenMonitor.BodyLarge"
                            android:padding="12dp"
                            android:buttonTint="?attr/colorPrimary" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Screen Capture Section Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ScreenMonitor.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_screen_capture"
                        android:textAppearance="@style/TextAppearance.ScreenMonitor.TitleMedium"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/section_screen_capture_desc"
                        android:textAppearance="@style/TextAppearance.ScreenMonitor.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartCapture"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/btn_start_capture"
                            app:icon="@drawable/ic_play_circle"
                            app:iconGravity="start"
                            app:iconPadding="8dp"
                            style="@style/Widget.ScreenMonitor.Button.Filled" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStopCapture"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/btn_stop_capture"
                            app:icon="@drawable/ic_stop_circle"
                            app:iconGravity="start"
                            app:iconPadding="8dp"
                            style="@style/Widget.ScreenMonitor.Button.Tonal" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Permissions Section Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ScreenMonitor.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_permissions"
                        android:textAppearance="@style/TextAppearance.ScreenMonitor.TitleMedium"
                        android:textColor="?attr/colorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestPermissions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/btn_request_permissions"
                        app:icon="@drawable/ic_security"
                        app:iconGravity="start"
                        app:iconPadding="8dp"
                        style="@style/Widget.ScreenMonitor.Button.Outlined" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/desc_permissions"
                        android:textAppearance="@style/TextAppearance.ScreenMonitor.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Info Section Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ScreenMonitor.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_how_it_works"
                        android:textAppearance="@style/TextAppearance.ScreenMonitor.TitleMedium"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/desc_how_it_works"
                        android:textAppearance="@style/TextAppearance.ScreenMonitor.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
</androidx.core.widget.NestedScrollView>